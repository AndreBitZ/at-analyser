{
  "name": "at-analyser-mac",
  "private": true,
  "version": "0.3.0",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pt.tojal.atanalyser",
    "productName": "AT Analyser",
    "electronDownload": { "arch": "arm64" },
    "asarUnpack": ["**/*.node"],
    "extraResources": [
      { "from": "../dist", "to": "appdata/dist" },
      { "from": "../server", "to": "appdata/server" },
      { "from": "../db", "to": "appdata/db" },
      { "from": "../node_modules", "to": "appdata/node_modules" }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "artifactName": "AT-Analyser-apple-silicon.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "files": ["main.mjs", "preload.cjs", "prefs.mjs"],
    "directories": { "output": "../release" }
  }
}
